  "templating": {
    "list": [
      {
        "name": "threshold",
        "type": "custom",
        "label": "Low Relevance Threshold",
        "query": "0.3, 0.4, 0.5, 0.6, 0.7, 0.8",
        "current": {
          "selected": true,
          "text": "0.5",
          "value": "0.5"
        },
        "options": [
          { "selected": false, "text": "0.3", "value": "0.3" },
          { "selected": false, "text": "0.4", "value": "0.4" },
          { "selected": true, "text": "0.5", "value": "0.5" },
          { "selected": false, "text": "0.6", "value": "0.6" },
          { "selected": false, "text": "0.7", "value": "0.7" },
          { "selected": false, "text": "0.8", "value": "0.8" }
        ]
      }
    ]
