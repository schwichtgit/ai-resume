    {
      "id": 5,
      "title": "Overall Request Duration Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(http_request_duration_seconds_bucket{handler=~\"$endpoint\"}[$__rate_interval])) by (le)",
          "legendFormat": "requests",
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "scheme", "schemeName": "Oranges" },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "scheme"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "bucketOffset": 0,
        "combine": false,
        "fillOpacity": 80,
        "gradientMode": "scheme",
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 6,
      "title": "SSE Streaming",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "title": "Time to First Token (TTFT)",
      "description": "Distribution of time between fetch response and first SSE data event, measured client-side",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"ai-resume-frontend\" && name = \"chat.send_message\" && span.chat.time_to_first_token_ms > 0 } | select(span.chat.time_to_first_token_ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "scheme", "schemeName": "Blues" },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "scheme"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "bucketOffset": 0,
        "combine": false,
        "fillOpacity": 80,
        "gradientMode": "scheme",
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 8,
      "title": "Streaming Duration",
      "description": "Distribution of SSE stream duration from first token to stream end, measured client-side",
