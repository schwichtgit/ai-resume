{
  "uid": "quality-evals",
  "title": "Quality Evals",
  "description": "Chat feedback metrics, positive/negative ratio, and feedback event logs for ai-resume",
  "tags": ["ai-resume", "observability", "quality", "feedback"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Feedback Rate",
      "type": "timeseries",
      "description": "Feedback submissions per second, broken down by rating",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(chat_feedback_total[$__rate_interval])) by (rating)",
          "legendFormat": "{{rating}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "showPoints": "auto",
            "pointSize": 5,
            "stacking": { "mode": "normal" },
            "axisPlacement": "auto",
            "lineWidth": 2
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "up" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "down" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "sum"] }
      }
    },
    {
      "id": 2,
      "title": "Total Feedback (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(chat_feedback_total[24h]))",
          "legendFormat": "Total Feedback"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 10 },
              { "color": "yellow", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "title": "Positive / Negative Ratio",
      "type": "piechart",
      "description": "Ratio of thumbs-up to thumbs-down feedback over the selected time range",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "up",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(chat_feedback_total{rating=\"up\"}[$__range]))",
          "legendFormat": "Positive"
        },
        {
          "refId": "down",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(chat_feedback_total{rating=\"down\"}[$__range]))",
          "legendFormat": "Negative"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Positive" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Negative" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["percent", "value"] }
      }
    },
    {
      "id": 4,
      "title": "Feedback Log",
      "type": "logs",
      "description": "Structured log entries for chat feedback events with links to Tempo traces",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"ai-resume-api\"} |= `Chat feedback received`",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "View Trace in Tempo",
              "url": "/explore?orgId=1&left=%5B%22now-1h%22,%22now%22,%22Tempo%22,%7B%22query%22:%22${__data.fields.traceID}%22%7D%5D",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": []
  },
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m"]
  }
}
