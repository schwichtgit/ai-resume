{
  "uid": "llm-cost",
  "title": "LLM Cost Tracker",
  "description": "Token usage, estimated cost, and request volume per LLM model for ai-resume",
  "tags": ["ai-resume", "observability", "llm", "cost"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Token Usage Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "input",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(llm_tokens_total{type=\"input\", model=~\"$model\"}[$__rate_interval])) by (model)",
          "legendFormat": "Input - {{model}}"
        },
        {
          "refId": "output",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(llm_tokens_total{type=\"output\", model=~\"$model\"}[$__rate_interval])) by (model)",
          "legendFormat": "Output - {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "showPoints": "auto",
            "pointSize": 5,
            "stacking": { "mode": "normal" },
            "axisPlacement": "auto",
            "lineWidth": 2
          },
          "unit": "short",
          "displayName": "tokens/sec"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "sum"] }
      }
    },
    {
      "id": 2,
      "title": "Total Tokens (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(llm_tokens_total[24h]))",
          "legendFormat": "Total Tokens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100000 },
              { "color": "red", "value": 1000000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "title": "LLM Requests (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 4 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(llm_requests_total[24h]))",
          "legendFormat": "Total Requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "title": "Token Usage per Model",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "input_tokens",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(llm_tokens_total{type=\"input\"}[$__range])) by (model)",
          "legendFormat": "Input Tokens",
          "format": "table",
          "instant": true
        },
        {
          "refId": "output_tokens",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(llm_tokens_total{type=\"output\"}[$__range])) by (model)",
          "legendFormat": "Output Tokens",
          "format": "table",
          "instant": true
        },
        {
          "refId": "requests",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(llm_requests_total[$__range])) by (model)",
          "legendFormat": "Requests",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "model" },
            "properties": [
              { "id": "custom.width", "value": 250 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Value #input_tokens", "desc": true }],
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "fields": ["Value #input_tokens", "Value #output_tokens", "Value #requests"]
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "model": "Model",
              "Value #input_tokens": "Input Tokens",
              "Value #output_tokens": "Output Tokens",
              "Value #requests": "Requests"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Estimated Cost per Model",
      "type": "table",
      "description": "Estimated cost based on per-token pricing. Uses configurable cost_per_input_token and cost_per_output_token variables (defaults: $0.003/1K input, $0.015/1K output).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "input_cost",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(llm_tokens_total{type=\"input\"}[$__range])) by (model) * $cost_per_input_token / 1000",
          "legendFormat": "Input Cost",
          "format": "table",
          "instant": true
        },
        {
          "refId": "output_cost",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(llm_tokens_total{type=\"output\"}[$__range])) by (model) * $cost_per_output_token / 1000",
          "legendFormat": "Output Cost",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "model" },
            "properties": [
              { "id": "unit", "value": "string" },
              { "id": "custom.width", "value": 250 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Value #input_cost", "desc": true }],
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "fields": ["Value #input_cost", "Value #output_cost"]
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "model": "Model",
              "Value #input_cost": "Input Cost ($)",
              "Value #output_cost": "Output Cost ($)"
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Request Count per Model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(llm_requests_total{model=~\"$model\"}[$__rate_interval])) by (model)",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "fillOpacity": 80,
            "gradientMode": "scheme",
            "showPoints": "never",
            "stacking": { "mode": "normal" },
            "axisPlacement": "auto",
            "lineWidth": 1,
            "barAlignment": 0
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "sum"] }
      }
    },
    {
      "id": 7,
      "title": "Cumulative Cost Over Time",
      "type": "timeseries",
      "description": "Running total of estimated LLM cost over the selected time range",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(llm_tokens_total{type=\"input\"}[$__rate_interval])) * $cost_per_input_token / 1000) + (sum(increase(llm_tokens_total{type=\"output\"}[$__rate_interval])) * $cost_per_output_token / 1000)",
          "legendFormat": "Estimated Cost"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "dark-green" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 30,
            "gradientMode": "scheme",
            "showPoints": "never",
            "stacking": { "mode": "none" },
            "axisPlacement": "auto",
            "lineWidth": 2
          },
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] }
      }
    },
    {
      "id": 8,
      "title": "Input vs Output Token Ratio",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "input",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(llm_tokens_total{type=\"input\"}[$__range]))",
          "legendFormat": "Input Tokens"
        },
        {
          "refId": "output",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(llm_tokens_total{type=\"output\"}[$__range]))",
          "legendFormat": "Output Tokens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["percent", "value"] }
      }
    },
    {
      "id": 9,
      "title": "Avg Tokens per Request",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 24 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(llm_tokens_total[$__range])) / sum(increase(llm_requests_total[$__range]))",
          "legendFormat": "Avg Tokens/Request"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2000 },
              { "color": "red", "value": 4000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 10,
      "title": "Avg Cost per Request",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 24 },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum(increase(llm_tokens_total{type=\"input\"}[$__range])) * $cost_per_input_token / 1000) + (sum(increase(llm_tokens_total{type=\"output\"}[$__range])) * $cost_per_output_token / 1000)) / sum(increase(llm_requests_total[$__range]))",
          "legendFormat": "Avg Cost"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "label": "Model",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(llm_tokens_total, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "sort": 1
      },
      {
        "name": "cost_per_input_token",
        "type": "textbox",
        "label": "Cost per 1K Input Tokens ($)",
        "current": {
          "selected": false,
          "text": "0.003",
          "value": "0.003"
        }
      },
      {
        "name": "cost_per_output_token",
        "type": "textbox",
        "label": "Cost per 1K Output Tokens ($)",
        "current": {
          "selected": false,
          "text": "0.015",
          "value": "0.015"
        }
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m"]
  }
}
